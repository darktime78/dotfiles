# Your name and e-mail are in ~/.gitconfig.local (written by install.sh, not in git),
# so commits are never made under someone else's name.
[include]
	path = ~/.gitconfig.local
[core]
	editor = vim
[init]
	defaultBranch = master
[pull]
	ff = only
[rebase]
	autoStash = true
[alias]
	sts = status --short --branch

	lg = log --graph --pretty=format:\"%C(yellow)%h%C(auto)%d%C(reset) %s %C(bold blue)<%an>%C(reset)\"
	llog = log --graph --all --pretty=format:\"%C(yellow)%h%C(auto)%d%C(reset) %s %C(bold blue)<%an>%C(reset)\"

	datelg = log --graph --pretty=format:\"%C(yellow)%h%C(auto)%d%C(reset) %s %C(bold green)(%cr) %C(bold blue)<%an>%C(reset)\"
	datellog = log --graph --all --pretty=format:\"%C(yellow)%h%C(auto)%d%C(reset) %s %C(bold green)(%cr) %C(bold blue)<%an>%C(reset)\"
[push]
	default = simple
