# Overrides for the nvim-cpp container (docker --env-file format: NAME=value,
# no quotes). Leave everything empty when you use arch-local-ai: the container
# reads the ports from ~/.config/localai/localai.conf and uses your
# ~/.config/opencode config.
#
# The container runs with --net host, so 127.0.0.1 is your machine.

# Router (OpenCode). Empty: http://127.0.0.1:ROUTER_PORT (8080)
LOCALAI_URL=

# llama.cpp autocomplete server for llama.vim. Empty: http://127.0.0.1:FIM_PORT (8012)
LOCALAI_FIM_URL=

# Only used when no OpenCode config is mounted. Empty: qwen-agent
LOCALAI_CHAT_MODEL=

# Only if the server was started with an API key
LOCALAI_API_KEY=
