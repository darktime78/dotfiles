#!/bin/bash
#
# battery-notify: low battery notifications (sway and i3).
#
# Waybar's battery module shows the charge but does not notify. This loop
# wakes up once a minute and only reads sysfs with shell builtins, so it
# costs practically nothing.
#
# Usage: battery-notify [warning_percent] [critical_percent]

WARN=${1:-15}
CRIT=${2:-5}

shopt -s nullglob
bats=(/sys/class/power_supply/BAT*)
(( ${#bats[@]} )) || exit 0 # no battery (desktop)
BAT=${bats[0]}

# Only one instance per session
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/battery-notify.lock"
flock -n 9 || exit 0

level=100 # lowest level we already notified about

while :; do
	if read -r cap <"$BAT/capacity" && read -r status <"$BAT/status"; then
		if [[ $status != Discharging ]]; then
			level=100
		elif (( cap <= CRIT && level > CRIT )); then
			notify-send -u critical -i battery-caution \
				"Battery critical: $cap%" "Plug in the charger now."
			level=$CRIT
		elif (( cap <= WARN && level > WARN )); then
			notify-send -u normal -i battery-low \
				"Battery low: $cap%" "Consider plugging in the charger."
			level=$WARN
		fi
	fi
	sleep 60
done
