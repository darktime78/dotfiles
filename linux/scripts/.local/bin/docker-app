#!/bin/bash
#
# docker-app: start one of your docker apps (rofi, launchers, key bindings).
# The apps are the functions in ~/.config/docker/dockerfunc (and
# ~/.config/docker/dockerfunc_extra), the same ones you call from zsh.
#
#   docker-app NAME      e.g. docker-app steam
#
# - already running        -> just a notification
# - old stopped container  -> removed first
# - interactive (-it) apps -> opened in an alacritty window
# - errors                 -> notification, details in $XDG_RUNTIME_DIR/docker_apps.log

NAME=$1
LOG="${XDG_RUNTIME_DIR:-/tmp}/docker_apps.log"
FUNCS=(~/.config/docker/dockerfunc ~/.config/docker/dockerfunc_extra)

if [[ -z $NAME ]]; then
	echo "usage: $0 NAME" >&2
	exit 1
fi

for f in "${FUNCS[@]}"; do
	# shellcheck source=/dev/null
	[[ -f $f ]] && source "$f"
done

if ! declare -F "$NAME" >/dev/null; then
	notify-send -u critical "Docker" "No function '$NAME' in ~/.config/docker/dockerfunc"
	exit 1
fi

if ! docker info >/dev/null 2>&1; then
	notify-send -u critical "Docker" "Docker is not running, or your user is not in the 'docker' group"
	exit 1
fi

state=$(docker container inspect --format '{{.State.Running}}' "$NAME" 2>/dev/null)
if [[ $state == true ]]; then
	notify-send -t 2500 "$NAME" "Already running"
	exit 0
fi
[[ $state == false ]] && docker rm "$NAME" >/dev/null 2>&1

# Interactive containers (docker run -it) need a terminal
if declare -f "$NAME" | grep -q -- ' -it '; then
	exec alacritty --class "docker-$NAME" -e bash -c \
		"for f in ${FUNCS[*]}; do [[ -f \$f ]] && source \$f; done; $NAME"
fi

echo "$(date '+%F %T') starting $NAME" >>"$LOG"
if "$NAME" >>"$LOG" 2>&1; then
	notify-send -t 2500 "$NAME" "Starting..."
else
	notify-send -u critical "$NAME" "Failed to start, see $LOG"
fi
