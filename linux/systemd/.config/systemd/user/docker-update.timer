[Unit]
Description=Check daily whether Docker images are due for an update (every 7 days)

[Timer]
# daily check; update.sh --auto only works when the last update is older than
# 7 days (DOCKER_UPDATE_DAYS), so a skipped day (battery, offline) just retries
OnCalendar=daily
RandomizedDelaySec=1h
# also catch up after the laptop was off at that time
Persistent=true

[Install]
WantedBy=timers.target
