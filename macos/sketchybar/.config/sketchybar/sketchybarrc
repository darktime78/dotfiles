#!/bin/bash
# SketchyBar (macOS): the same bar as waybar / polybar on Linux, in one top bar.
# Colours and icons: colors.sh (GENERATED by tools/make_bars.py).
# Segments: icon part (darker shade) + text part, like the powerline blocks on Linux.
# Everything is event driven or slow polling; plugins/ hold the small scripts.

CONFIG_DIR=${CONFIG_DIR:-$HOME/.config/sketchybar}
PLUGINS=$CONFIG_DIR/plugins
source "$CONFIG_DIR/colors.sh"

sketchybar --bar position=top height=28 color=$BAR_COLOR shadow=off \
	padding_left=6 padding_right=6 topmost=off

sketchybar --default \
	icon.font="$ICON_FONT:Regular:14.0" icon.color=$ICON_COLOR \
	label.font="Hack Nerd Font:Bold:12.0" label.color=$TEXT_COLOR \
	icon.padding_left=7 icon.padding_right=7 label.padding_left=7 label.padding_right=7 \
	icon.background.height=22 label.background.height=22 \
	icon.background.corner_radius=0 label.background.corner_radius=0 \
	padding_left=2 padding_right=2 updates=when_shown

# seg NAME POSITION COLOR: one powerline-like segment (COLOR = GREEN GREY PLUM OLIVE CLAY)
seg() {
	local a=${3}_A b=${3}_B
	sketchybar --add item "$1" "$2" --set "$1" \
		icon.background.drawing=on icon.background.color=${!a} \
		label.background.drawing=on label.background.color=${!b}
}

# ------------------------------------------------------------ left: workspaces
sketchybar --add event aerospace_workspace_change
for sid in $(aerospace list-workspaces --all); do
	ws_icon=WS_ICON_$sid
	sketchybar --add item space.$sid left \
		--subscribe space.$sid aerospace_workspace_change front_app_switched \
		--set space.$sid \
		icon="$sid" icon.font="Hack Nerd Font:Bold:12.0" icon.padding_right=2 \
		label="${!ws_icon:-}" label.font="$ICON_FONT:Regular:14.0" label.padding_left=2 \
		background.color=$WS_COLOR background.corner_radius=3 background.height=20 \
		background.drawing=on \
		click_script="aerospace workspace $sid" \
		script="$PLUGINS/aerospace.sh $sid"
done

sketchybar --add item front_app left \
	--subscribe front_app front_app_switched \
	--set front_app icon.drawing=off label.color=$WS_TEXT script="$PLUGINS/front_app.sh"

# ------------------------------------------------------------ right (added right to left)
seg clock right CLAY
sketchybar --set clock icon="$ICON_CLOCK" update_freq=30 script="$PLUGINS/clock.sh"

seg date right CLAY
sketchybar --set date icon="$ICON_CAL" update_freq=60 script="$PLUGINS/date.sh" \
	click_script="open -a Calendar"

sketchybar --add event input_change AppleSelectedInputSourcesChangedNotification
seg input right OLIVE
sketchybar --set input icon="$ICON_LANG" script="$PLUGINS/input.sh" \
	label.font="Hack Nerd Font:Regular:13.0" --subscribe input input_change

seg load right GREY
sketchybar --set load icon="$ICON_CPU" update_freq=10 script="$PLUGINS/load.sh" \
	click_script="open -a 'Activity Monitor'"

seg battery right GREEN
sketchybar --set battery update_freq=60 script="$PLUGINS/battery.sh" \
	--subscribe battery power_source_change system_woke

seg disk right GREY
sketchybar --set disk icon="$ICON_DISK" update_freq=120 script="$PLUGINS/disk.sh"

seg volume right GREEN
sketchybar --set volume script="$PLUGINS/volume.sh" \
	click_script="open 'x-apple.systempreferences:com.apple.Sound-Settings.extension'" \
	--subscribe volume volume_change

seg wifi right PLUM
sketchybar --set wifi icon="$ICON_WIFI" script="$PLUGINS/wifi.sh" update_freq=60 \
	click_script="open 'x-apple.systempreferences:com.apple.wifi-settings-extension'" \
	--subscribe wifi wifi_change system_woke

sketchybar --update
