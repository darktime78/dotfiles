// Waybar (sway): two bars (top + bottom) in ONE waybar process.
// GENERATED by tools/make_bars.py - edit that file, not this one.
// Powerline segments are Pango markup. Low CPU: modules are event driven or
// poll slowly (network speed 10 s, load 20 s, memory / Wi-Fi 30 s); only the
// traffic counter (60 s) and the FIM/Router buttons (120 s, a click refreshes
// at once) run a small script.
[
  {
    "layer": "top",
    "position": "top",
    "height": 12,
    "reload_style_on_change": true,
    "modules-left": [
      "sway/workspaces",
      "sway/mode",
      "sway/scratchpad"
    ],
    "modules-right": [
      "idle_inhibitor",
      "pulseaudio",
      "backlight",
      "memory",
      "disk",
      "power-profiles-daemon",
      "battery",
      "cpu",
      "sway/language",
      "clock#time",
      "tray"
    ],
    "sway/workspaces": {
      "disable-scroll": true,
      "format": "<span foreground='#64727d'>\ue0be</span><span background='#64727d'>\u2009{value}{icon}\u2009</span><span foreground='#64727d'>\ue0b8</span>",
      "format-icons": {
        "1": "\u2009<span font_family='Hack Nerd Font Propo'>\uf269</span>",
        "2": "\u2009<span font_family='Hack Nerd Font Propo'>\uf120</span>",
        "3": "\u2009<span font_family='Hack Nerd Font Propo'>\ue6ae</span>",
        "4": "\u2009<span font_family='Hack Nerd Font Propo'>\uf1b6</span>",
        "5": "\u2009<span font_family='Hack Nerd Font Propo'>\uf268</span>",
        "6": "\u2009<span font_family='Hack Nerd Font Propo'>\uf07c</span>",
        "7": "\u2009<span font_family='Hack Nerd Font Propo'>\uf0e0</span>",
        "8": "\u2009<span font_family='Hack Nerd Font Propo'>\uec82</span>",
        "9": "\u2009<span font_family='Hack Nerd Font Propo'>\uf2c6</span>",
        "10": "\u2009<span font_family='Hack Nerd Font Propo'>\udb84\udd22</span>",
        "default": ""
      }
    },
    "sway/mode": {
      "format": "\uf054\uf105 {}"
    },
    "sway/scratchpad": {
      "format": "{icon} {count}",
      "show-empty": false,
      "format-icons": [
        "",
        "\uf2d2"
      ],
      "tooltip-format": "{app}: {title}"
    },
    "idle_inhibitor": {
      "format": "{icon}",
      "format-icons": {
        "activated": "<span background='#c77a69' foreground='#2f343f'>\ue0b8</span><span background='#c77a69' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf06e</span><span background='#2f343f' foreground='#c77a69'>\ue0b8</span>",
        "deactivated": "<span background='#445d67' foreground='#2f343f'>\ue0b8</span><span background='#445d67' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf070</span><span background='#2f343f' foreground='#445d67'>\ue0b8</span>"
      },
      "tooltip-format-activated": "Screen stays on (auto lock off)",
      "tooltip-format-deactivated": "Auto lock / screen off on"
    },
    "pulseaudio": {
      "format": "<span background='#597262' foreground='#2f343f'>\ue0b8</span><span background='#597262' foreground='#000000' font_family='Hack Nerd Font Propo'>{icon}</span><span background='#4d504e' foreground='#597262'>\ue0b8</span><span background='#4d504e' foreground='#eef6eb'>{volume}%</span><span background='#2f343f' foreground='#4d504e'>\ue0b8</span>",
      "format-bluetooth": "<span background='#597262' foreground='#2f343f'>\ue0b8</span><span background='#597262' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf293</span><span background='#4d504e' foreground='#597262'>\ue0b8</span><span background='#4d504e' foreground='#eef6eb'>{volume}%</span><span background='#2f343f' foreground='#4d504e'>\ue0b8</span>",
      "format-muted": "<span background='#597262' foreground='#2f343f'>\ue0b8</span><span background='#597262' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf026</span><span background='#4d504e' foreground='#597262'>\ue0b8</span><span background='#4d504e' foreground='#eef6eb'>MUTE</span><span background='#2f343f' foreground='#4d504e'>\ue0b8</span>",
      "format-icons": {
        "headphone": "\uf025",
        "default": [
          "\uf026",
          "\uf027",
          "\uf028"
        ]
      },
      "scroll-step": 5,
      "max-volume": 100,
      "tooltip-format": "{desc}\nClick: mixer, right click: mute, scroll: volume",
      "on-click": "pavucontrol",
      "on-click-right": "pamixer -t"
    },
    "backlight": {
      "format": "<span background='#597262' foreground='#2f343f'>\ue0b8</span><span background='#597262' foreground='#000000' font_family='Hack Nerd Font Propo'>{icon}</span><span background='#4d504e' foreground='#597262'>\ue0b8</span><span background='#4d504e' foreground='#eef6eb'>{percent}%</span><span background='#2f343f' foreground='#4d504e'>\ue0b8</span>",
      "format-icons": [
        "\uf186",
        "\uf185"
      ],
      "scroll-step": 5,
      "tooltip": false
    },
    "memory": {
      "interval": 30,
      "format": "<span background='#445d67' foreground='#2f343f'>\ue0b8</span><span background='#445d67' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf2db</span><span background='#3b4549' foreground='#445d67'>\ue0b8</span><span background='#3b4549' foreground='#eef6eb'>{avail:0.1f}G</span><span background='#2f343f' foreground='#3b4549'>\ue0b8</span>",
      "format-critical": "<span background='#445d67' foreground='#2f343f'>\ue0b8</span><span background='#445d67' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf2db</span><span background='#3b4549' foreground='#445d67'>\ue0b8</span><span background='#3b4549' foreground='#ff5252'>{avail:0.1f}G</span><span background='#2f343f' foreground='#3b4549'>\ue0b8</span>",
      "states": {
        "critical": 90
      },
      "tooltip-format": "Used {used:0.1f}G of {total:0.1f}G\nSwap {swapUsed:0.1f}G",
      "on-click": "alacritty -e htop"
    },
    "disk": {
      "interval": 300,
      "path": "/home",
      "format": "<span background='#445d67' foreground='#2f343f'>\ue0b8</span><span background='#445d67' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf0a0</span><span background='#3b4549' foreground='#445d67'>\ue0b8</span><span background='#3b4549' foreground='#eef6eb'>{free}</span><span background='#2f343f' foreground='#3b4549'>\ue0b8</span>",
      "format-alt": "<span background='#445d67' foreground='#2f343f'>\ue0b8</span><span background='#445d67' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf0a0</span><span background='#3b4549' foreground='#445d67'>\ue0b8</span><span background='#3b4549' foreground='#eef6eb'>{percentage_used}%</span><span background='#2f343f' foreground='#3b4549'>\ue0b8</span>",
      "format-alt-click": "click-right",
      "format-critical": "<span background='#445d67' foreground='#2f343f'>\ue0b8</span><span background='#445d67' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf0a0</span><span background='#3b4549' foreground='#445d67'>\ue0b8</span><span background='#3b4549' foreground='#ff5252'>{free}</span><span background='#2f343f' foreground='#3b4549'>\ue0b8</span>",
      "states": {
        "critical": 90
      },
      "tooltip-format": "{path}: {used} of {total} used"
    },
    "power-profiles-daemon": {
      "format": "{icon}",
      "format-icons": {
        "default": "<span background='#597262' foreground='#2f343f'>\ue0b8</span><span background='#597262' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf24e</span><span background='#2f343f' foreground='#597262'>\ue0b8</span>",
        "performance": "<span background='#c77a69' foreground='#2f343f'>\ue0b8</span><span background='#c77a69' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf135</span><span background='#2f343f' foreground='#c77a69'>\ue0b8</span>",
        "balanced": "<span background='#597262' foreground='#2f343f'>\ue0b8</span><span background='#597262' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf24e</span><span background='#2f343f' foreground='#597262'>\ue0b8</span>",
        "power-saver": "<span background='#597262' foreground='#2f343f'>\ue0b8</span><span background='#597262' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf06c</span><span background='#2f343f' foreground='#597262'>\ue0b8</span>"
      },
      "tooltip-format": "Power profile: {profile}\nClick to change"
    },
    "battery": {
      "interval": 60,
      "states": {
        "warning": 25,
        "critical": 10
      },
      "format": "<span background='#597262' foreground='#2f343f'>\ue0b8</span><span background='#597262' foreground='#000000' font_family='Hack Nerd Font Propo'>{icon}</span><span background='#4d504e' foreground='#597262'>\ue0b8</span><span background='#4d504e' foreground='#eef6eb'>{capacity}%</span><span background='#2f343f' foreground='#4d504e'>\ue0b8</span>",
      "format-warning": "<span background='#597262' foreground='#2f343f'>\ue0b8</span><span background='#597262' foreground='#000000' font_family='Hack Nerd Font Propo'>{icon}</span><span background='#4d504e' foreground='#597262'>\ue0b8</span><span background='#4d504e' foreground='#ffcc66'>{capacity}%</span><span background='#2f343f' foreground='#4d504e'>\ue0b8</span>",
      "format-critical": "<span background='#597262' foreground='#2f343f'>\ue0b8</span><span background='#597262' foreground='#000000' font_family='Hack Nerd Font Propo'>{icon}</span><span background='#4d504e' foreground='#597262'>\ue0b8</span><span background='#4d504e' foreground='#ff5252'>{capacity}%</span><span background='#2f343f' foreground='#4d504e'>\ue0b8</span>",
      "format-charging": "<span background='#597262' foreground='#2f343f'>\ue0b8</span><span background='#597262' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf0e7</span><span background='#4d504e' foreground='#597262'>\ue0b8</span><span background='#4d504e' foreground='#eef6eb'>{capacity}%</span><span background='#2f343f' foreground='#4d504e'>\ue0b8</span>",
      "format-plugged": "<span background='#597262' foreground='#2f343f'>\ue0b8</span><span background='#597262' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf1e6</span><span background='#4d504e' foreground='#597262'>\ue0b8</span><span background='#4d504e' foreground='#eef6eb'>{capacity}%</span><span background='#2f343f' foreground='#4d504e'>\ue0b8</span>",
      "format-full": "<span background='#597262' foreground='#2f343f'>\ue0b8</span><span background='#597262' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf1e6</span><span background='#4d504e' foreground='#597262'>\ue0b8</span><span background='#4d504e' foreground='#eef6eb'>{capacity}%</span><span background='#2f343f' foreground='#4d504e'>\ue0b8</span>",
      "format-icons": [
        "\uf244",
        "\uf243",
        "\uf242",
        "\uf241",
        "\uf240"
      ],
      "tooltip-format": "{timeTo}\nDrain: {power:0.1f} W"
    },
    "cpu": {
      "interval": 20,
      "format": "<span background='#445d67' foreground='#2f343f'>\ue0b8</span><span background='#445d67' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf0e4</span><span background='#3b4549' foreground='#445d67'>\ue0b8</span><span background='#3b4549' foreground='#eef6eb'>{load:0.2f}</span><span background='#2f343f' foreground='#3b4549'>\ue0b8</span>",
      "format-critical": "<span background='#445d67' foreground='#2f343f'>\ue0b8</span><span background='#445d67' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf0e4</span><span background='#3b4549' foreground='#445d67'>\ue0b8</span><span background='#3b4549' foreground='#ff5252'>{load:0.2f}</span><span background='#2f343f' foreground='#3b4549'>\ue0b8</span>",
      "states": {
        "critical": 90
      },
      "tooltip-format": "CPU usage: {usage}%",
      "on-click": "alacritty -e htop"
    },
    "sway/language": {
      "format": "<span background='#8b8367' foreground='#2f343f'>\ue0b8</span><span background='#8b8367' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf1ab</span><span background='#626059' foreground='#8b8367'>\ue0b8</span><span background='#626059' foreground='#eef6eb'>{flag}</span><span background='#2f343f' foreground='#626059'>\ue0b8</span>",
      "min-length": 7,
      "align": 0.5,
      "tooltip-format": "{long}  (click: next layout)",
      "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
    },
    "clock#time": {
      "format": "<span background='#c77a69' foreground='#2f343f'>\ue0b8</span><span background='#c77a69' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf017</span><span background='#8e665d' foreground='#c77a69'>\ue0b8</span><span background='#8e665d' foreground='#eef6eb'>{:%H:%M}</span><span background='#2f343f' foreground='#8e665d'>\ue0b8</span>",
      "interval": 60,
      "tooltip": false
    },
    "tray": {
      "icon-size": 12,
      "spacing": 6
    }
  },
  {
    "layer": "bottom",
    "position": "bottom",
    "height": 12,
    "modules-left": [
      "custom/fim",
      "custom/router"
    ],
    "modules-right": [
      "mpd",
      "network#speed",
      "network#wifi",
      "custom/downloaded",
      "bluetooth",
      "clock#date"
    ],
    "custom/fim": {
      "exec": "$HOME/.local/bin/bar-service fim",
      "return-type": "json",
      "interval": 120,
      "signal": 9,
      "format": "{icon}",
      "format-icons": {
        "on": "<span background='#c77a69' foreground='#2f343f'>\ue0b8</span><span background='#c77a69' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf121</span><span background='#8e665d' foreground='#c77a69'>\ue0b8</span><span background='#8e665d' foreground='#eef6eb'>FIM</span><span background='#2f343f' foreground='#8e665d'>\ue0b8</span>",
        "off": "<span background='#445d67' foreground='#2f343f'>\ue0b8</span><span background='#445d67' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf121</span><span background='#3b4549' foreground='#445d67'>\ue0b8</span><span background='#3b4549' foreground='#9aa0a6'>FIM</span><span background='#2f343f' foreground='#3b4549'>\ue0b8</span>"
      },
      "on-click": "$HOME/.local/bin/bar-service fim toggle"
    },
    "custom/router": {
      "exec": "$HOME/.local/bin/bar-service router",
      "return-type": "json",
      "interval": 120,
      "signal": 9,
      "format": "{icon}",
      "format-icons": {
        "on": "<span background='#c77a69' foreground='#2f343f'>\ue0b8</span><span background='#c77a69' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf0ec</span><span background='#8e665d' foreground='#c77a69'>\ue0b8</span><span background='#8e665d' foreground='#eef6eb'>Router</span><span background='#2f343f' foreground='#8e665d'>\ue0b8</span>",
        "off": "<span background='#445d67' foreground='#2f343f'>\ue0b8</span><span background='#445d67' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf0ec</span><span background='#3b4549' foreground='#445d67'>\ue0b8</span><span background='#3b4549' foreground='#9aa0a6'>Router</span><span background='#2f343f' foreground='#3b4549'>\ue0b8</span>"
      },
      "on-click": "$HOME/.local/bin/bar-service router toggle"
    },
    "mpd": {
      "format": "<span background='#597262' foreground='#2f343f'>\ue0b8</span><span background='#597262' foreground='#000000' font_family='Hack Nerd Font Propo'>{stateIcon}</span><span background='#4d504e' foreground='#597262'>\ue0b8</span><span background='#4d504e' foreground='#eef6eb'>{artist} - {title}</span><span background='#2f343f' foreground='#4d504e'>\ue0b8</span>",
      "state-icons": {
        "playing": "\uf04b",
        "paused": "\uf04c"
      },
      "format-stopped": "",
      "format-disconnected": "",
      "max-length": 40,
      "tooltip-format": "{album}\n{elapsedTime:%M:%S} / {totalTime:%M:%S}",
      "on-click": "mpc -q toggle",
      "on-scroll-up": "mpc -q prev",
      "on-scroll-down": "mpc -q next"
    },
    "network#speed": {
      "on-click": "alacritty --class nmtui -e nmtui",
      "interval": 10,
      "format": "<span background='#6e4555' foreground='#2f343f'>\ue0b8</span><span background='#6e4555' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf063</span><span background='#4e3c43' foreground='#6e4555'>\ue0b8</span><span background='#4e3c43' foreground='#eef6eb'>{bandwidthDownBytes}</span><span background='#6e4555' foreground='#4e3c43'>\ue0b8</span><span background='#6e4555' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf062</span><span background='#4e3c43' foreground='#6e4555'>\ue0b8</span><span background='#4e3c43' foreground='#eef6eb'>{bandwidthUpBytes}</span><span background='#2f343f' foreground='#4e3c43'>\ue0b8</span>",
      "format-disconnected": "",
      "tooltip": false
    },
    "network#wifi": {
      "on-click": "alacritty --class nmtui -e nmtui",
      "interval": 30,
      "format-wifi": "<span background='#6e4555' foreground='#2f343f'>\ue0b8</span><span background='#6e4555' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf1eb</span><span background='#4e3c43' foreground='#6e4555'>\ue0b8</span><span background='#4e3c43' foreground='#eef6eb'>{essid} - {ipaddr}</span><span background='#6e4555' foreground='#4e3c43'>\ue0b8</span><span background='#6e4555' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf012</span><span background='#4e3c43' foreground='#6e4555'>\ue0b8</span><span background='#4e3c43' foreground='#eef6eb'>{signalStrength}%</span><span background='#2f343f' foreground='#4e3c43'>\ue0b8</span>",
      "format-ethernet": "<span background='#6e4555' foreground='#2f343f'>\ue0b8</span><span background='#6e4555' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf0e8</span><span background='#4e3c43' foreground='#6e4555'>\ue0b8</span><span background='#4e3c43' foreground='#eef6eb'>{ipaddr}</span><span background='#2f343f' foreground='#4e3c43'>\ue0b8</span>",
      "format-linked": "<span background='#6e4555' foreground='#2f343f'>\ue0b8</span><span background='#6e4555' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf0e8</span><span background='#4e3c43' foreground='#6e4555'>\ue0b8</span><span background='#4e3c43' foreground='#eef6eb'>no IP</span><span background='#2f343f' foreground='#4e3c43'>\ue0b8</span>",
      "format-disconnected": "<span background='#6e4555' foreground='#2f343f'>\ue0b8</span><span background='#6e4555' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf1eb</span><span background='#4e3c43' foreground='#6e4555'>\ue0b8</span><span background='#4e3c43' foreground='#eef6eb'>down</span><span background='#2f343f' foreground='#4e3c43'>\ue0b8</span>",
      "tooltip-format": "{ifname}: {ipaddr}/{cidr} via {gwaddr}",
      "tooltip-format-wifi": "{essid} {frequency} GHz\n{ifname}: {ipaddr}/{cidr} via {gwaddr}"
    },
    "custom/downloaded": {
      "exec": "$HOME/.local/bin/net-total",
      "signal": 8,
      "return-type": "json",
      "interval": 60,
      "format": "<span background='#6e4555' foreground='#2f343f'>\ue0b8</span><span background='#6e4555' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf063</span><span background='#4e3c43' foreground='#6e4555'>\ue0b8</span><span background='#4e3c43' foreground='#eef6eb'>{}</span><span background='#6e4555' foreground='#4e3c43'>\ue0b8</span><span background='#6e4555' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf062</span><span background='#4e3c43' foreground='#6e4555'>\ue0b8</span><span background='#4e3c43' foreground='#eef6eb'>{alt}</span><span background='#2f343f' foreground='#4e3c43'>\ue0b8</span>",
      "on-click-right": "$HOME/.local/bin/net-total-reset"
    },
    "bluetooth": {
      "format": "<span background='#6e4555' foreground='#2f343f'>\ue0b8</span><span background='#6e4555' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf294</span><span background='#4e3c43' foreground='#6e4555'>\ue0b8</span><span background='#4e3c43' foreground='#eef6eb'>on</span><span background='#2f343f' foreground='#4e3c43'>\ue0b8</span>",
      "format-off": "<span background='#6e4555' foreground='#2f343f'>\ue0b8</span><span background='#6e4555' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf294</span><span background='#4e3c43' foreground='#6e4555'>\ue0b8</span><span background='#4e3c43' foreground='#eef6eb'>down</span><span background='#2f343f' foreground='#4e3c43'>\ue0b8</span>",
      "format-disabled": "<span background='#6e4555' foreground='#2f343f'>\ue0b8</span><span background='#6e4555' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf294</span><span background='#4e3c43' foreground='#6e4555'>\ue0b8</span><span background='#4e3c43' foreground='#eef6eb'>down</span><span background='#2f343f' foreground='#4e3c43'>\ue0b8</span>",
      "format-connected": "<span background='#6e4555' foreground='#2f343f'>\ue0b8</span><span background='#6e4555' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf294</span><span background='#4e3c43' foreground='#6e4555'>\ue0b8</span><span background='#4e3c43' foreground='#eef6eb'>Con: {num_connections}</span><span background='#2f343f' foreground='#4e3c43'>\ue0b8</span>",
      "format-no-controller": "",
      "tooltip-format": "Bluetooth {status}",
      "tooltip-format-connected": "{device_enumerate}",
      "tooltip-format-enumerate-connected": "{device_alias}",
      "on-click": "alacritty --class bluetoothctl -e bluetoothctl"
    },
    "clock#date": {
      "format": "<span background='#c77a69' foreground='#2f343f'>\ue0b8</span><span background='#c77a69' foreground='#000000' font_family='Hack Nerd Font Propo'>\uf073</span><span background='#8e665d' foreground='#c77a69'>\ue0b8</span><span background='#8e665d' foreground='#eef6eb'>{:%a %d %b}</span><span background='#2f343f' foreground='#8e665d'>\ue0b8</span>",
      "interval": 60,
      "tooltip-format": "<tt><small>{calendar}</small></tt>",
      "calendar": {
        "mode": "month",
        "mode-mon-col": 1,
        "weeks-pos": "right",
        "on-scroll": 1,
        "format": {
          "months": "<span color='#ffead3'><b>{}</b></span>",
          "days": "<span color='#ecc6d9'><b>{}</b></span>",
          "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
          "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
          "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
        }
      },
      "actions": {
        "on-click-right": "mode",
        "on-scroll-up": "shift_up",
        "on-scroll-down": "shift_down"
      }
    }
  }
]
