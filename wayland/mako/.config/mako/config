# mako notification daemon (man 5 mako)
# The lock screen and $mod+n switch to the "do-not-disturb" mode below
# instead of rewriting this file.

anchor=bottom-right
layer=overlay
font=Hack 10
background-color=#2F343FCF
text-color=#eef6ebFF
border-size=0
border-radius=10
padding=10
margin=12
width=360
max-visible=5
icons=1
max-icon-size=48

# Close notifications automatically after 8 s (critical ones stay)
default-timeout=8000
ignore-timeout=0

[urgency=low]
default-timeout=4000

[urgency=critical]
background-color=#B71C1CE6
default-timeout=0

[mode=do-not-disturb]
invisible=1
